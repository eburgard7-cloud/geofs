# The race server image is built from the repo root (docker build -f race/server/Dockerfile .).
# Allow-list: everything is excluded except what the Dockerfile COPYs, so .git,
# node_modules and the rest of the repo never enter the build context (only the livery subset below).
*
!race/server/requirements.txt
!race/server/app.py
!race/server/migrate_modes.py
!race/server/airportdb.py
!race/server/runhooks.py
!race/server/dash_engine.py
!race/server/rogue_engine.py
!race/data/upgrades.json
!race/server/gungame_engine.py
!race/data/gungame.json
!race/server/airports/airports.json.gz
!race/server/static
!race/server/static/*
!race/courses/*.json
!race/runways/*.json
!race/models
!race/models/*
!race/rivals/index.json
!race/campaign/*.json
!race/bookmarklet.txt
!race/server/garage.py
!race/server/livery_worker.py
# Liveries (the Garage): what the server serves or renders with, laid out under /app/livery by the
# Dockerfile. Not liveries/specs, liveries/test or liveries/out/sheets.
!liveries/catalog.json
!liveries/out/*.webp
!liveries/out/*.png
!liveries/out/*.jpg
!liveries/uv/*
!liveries/fonts/*
!liveries/decals/*
!liveries/templates/*.json
!liveries/gungame/*.json
!liveries/kit/*
!tools/*.py
!rafale/stock_*.png
!rafale/*.webp
!*.png
!*.webp
