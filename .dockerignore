# The race server image is built from the repo root (docker build -f race/server/Dockerfile .).
# Allow-list: everything is excluded except what the Dockerfile COPYs, so liveries, .git,
# node_modules and the rest of the repo never enter the build context.
*
!race/server/requirements.txt
!race/server/app.py
!race/server/migrate_modes.py
!race/server/airportdb.py
!race/server/runhooks.py
!race/server/dash_engine.py
!race/server/airports/airports.json.gz
!race/server/static
!race/server/static/*
!race/courses/*.json
!race/runways/*.json
!race/models
!race/models/*
!race/rivals/index.json
!race/campaign/*.json
!race/bookmarklet.txt
