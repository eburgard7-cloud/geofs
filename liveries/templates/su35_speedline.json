{
  "id": "su35_speedline",
  "aircraft": "su35",
  "name": "Speedline",
  "description": "Body colour with a double cheatline, twin spine stripes, chord stripes on both wings, fin bands, your name along the spine and a number on both fins.",
  "params": {
    "base": {
      "type": "color",
      "default": "#8f959c",
      "label": "Body"
    },
    "stripe": {
      "type": "color",
      "default": "#f47a20",
      "label": "Stripes"
    },
    "accent": {
      "type": "color",
      "default": "#ffffff",
      "label": "Accent"
    },
    "title": {
      "type": "text",
      "default": "FINSONLY",
      "max": 10,
      "label": "Name on the spine"
    },
    "tail": {
      "type": "tail",
      "default": "N4800F",
      "label": "Tail number"
    }
  },
  "spec": {
    "base": {"*": "{{base}}"},
    "layers": [
      {"type": "gradient", "axis": "height", "stops": [[0.0, "{{base|dark:0.22}}"], [0.5, "{{base}}"], [1.0, "{{base|light:0.08}}"]]},
      {"type": "stripe", "regions": ["fuselage_*", "intake", "radome"], "axis": "height", "center": 0.31, "width": 0.016, "color": "{{stripe}}", "outline_color": "{{stripe|dark:0.45}}", "outline_width": 0.003},
      {"type": "stripe", "regions": ["fuselage_*", "intake", "radome"], "axis": "height", "center": 0.285, "width": 0.005, "color": "{{accent}}"},
      {"type": "fill", "regions": ["radome"], "color": "{{stripe}}"},
      {"type": "stripe", "regions": ["fuselage_top"], "axis": "lat", "center": 0.47, "width": 0.014, "color": "{{stripe}}", "where": {"length": [0.3, 0.9]}},
      {"type": "stripe", "regions": ["fuselage_top"], "axis": "lat", "center": 0.53, "width": 0.014, "color": "{{stripe}}", "where": {"length": [0.3, 0.9]}},
      {"type": "stripe", "regions": ["wing_top_l", "wing_top_r", "wing_both", "flaperons", "wing_leading_edges"], "axis": "lat", "center": 0.15, "width": 0.04, "color": "{{stripe}}"},
      {"type": "stripe", "regions": ["wing_top_l", "wing_top_r", "wing_both", "flaperons", "wing_leading_edges"], "axis": "lat", "center": 0.85, "width": 0.04, "color": "{{stripe}}"},
      {"type": "stripe", "regions": ["fin_l", "fin_r", "fin", "rudder"], "axis": "height", "center": 0.82, "width": 0.05, "color": "{{stripe}}"},
      {"type": "stripe", "regions": ["fin_l", "fin_r", "fin", "rudder"], "axis": "height", "center": 0.86, "width": 0.01, "color": "{{accent}}"},
      {"type": "fill", "regions": ["fin_l", "fin_r", "fin", "rudder"], "where": {"height": [0.95, 1.0]}, "color": "{{stripe}}"},
      {"type": "text", "text": "{{title}}", "font": "Bungee-Regular.ttf", "size": 150, "color": "{{stripe}}", "stroke": 0.08, "stroke_color": "{{base|dark:0.65}}", "region": "fuselage_top", "anchor": {"length": 0.6, "lat": 0.5, "height": 0.45}, "anchor_radius": 600, "baseline": "+length", "up": "+lat"},
      {"type": "text", "text": "{{tail}}", "font": "Anton-Regular.ttf", "size": 110, "color": "{{accent}}", "region": "fin_l", "component": 0, "at": [0.45, 0.55], "baseline": "+length", "up": "+height"},
      {"type": "text", "text": "{{tail}}", "font": "Anton-Regular.ttf", "size": 110, "color": "{{accent}}", "region": "fin_r", "component": 0, "at": [0.45, 0.55], "baseline": "-length", "up": "+height"}
    ],
    "finish": {"wear": 0.15, "soot": 0.4}
  }
}
