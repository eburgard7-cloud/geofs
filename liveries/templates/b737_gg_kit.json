{
  "id": "b737_gg_kit",
  "aircraft": "b737",
  "name": "Gun Game kit (737-700)",
  "pilot": false,
  "description": "Gun Game rung paint for the 737-700: graphite body, heat belly, wing undersides, engines and tail, heat cheatline and tail slashes, hot wingtips, GUN GAME title.",
  "params": {
    "heat": {
      "type": "color",
      "default": "#5ec8ff",
      "label": "Heat colour"
    },
    "hot": {
      "type": "color",
      "default": "#d9f4ff",
      "label": "Hot highlight"
    },
    "label": {
      "type": "text",
      "default": "GUN GAME",
      "max": 12,
      "label": "Title"
    }
  },
  "spec": {
    "base": {"*": "#1d2026"},
    "layers": [
      {"type": "fill", "regions": ["fuselage_l", "fuselage_r", "fuselage_both", "nose_cone", "tail_cone", "wing_fairing"], "where": {"height": [0.0, 0.24]}, "color": "{{heat}}"},
      {"type": "stripe", "regions": ["fuselage_l", "fuselage_r", "fuselage_both", "nose_cone", "tail_cone", "wing_fairing"], "axis": "height", "center": 0.252, "width": 0.012, "color": "{{hot}}"},
      {"type": "stripe", "regions": ["fuselage_l", "fuselage_r", "fuselage_both", "nose_cone", "tail_cone", "wing_fairing"], "axis": "height", "slant": 0.35, "center": 0.43, "width": 0.03, "period": 0.09, "color": "{{heat}}", "where": {"length": [0.6, 0.95], "height": [0.24, 0.42]}},
      {"type": "gradient", "regions": ["fuselage_l", "fuselage_r", "fuselage_both", "nose_cone", "tail_cone", "wing_fairing"], "axis": "length", "range": [0.0, 0.12], "stops": [[0.0, "{{heat}}"], [1.0, "{{heat|alpha:0.0}}"]]},
      {"type": "gradient", "regions": ["fin_l", "fin_r", "rudder"], "axis": "height", "range": [0.35, 1.0], "stops": [[0.0, "{{heat|dark:0.35}}"], [0.6, "{{heat}}"], [1.0, "{{hot}}"]]},
      {"type": "fill", "regions": ["engines"], "color": "{{heat}}"},
      {"type": "fill", "regions": ["wing_bottom", "hstab_bottom"], "color": "{{heat}}"},
      {"type": "fill", "regions": ["wing_top_l", "wing_top_r", "wing_both"], "where": {"lat": [0.0, 0.1]}, "color": "{{hot}}"},
      {"type": "fill", "regions": ["wing_top_l", "wing_top_r", "wing_both"], "where": {"lat": [0.9, 1.0]}, "color": "{{hot}}"},
      {"type": "stripe", "regions": ["wing_top_l", "wing_top_r", "wing_both"], "axis": "lat", "center": 0.28, "width": 0.05, "color": "{{heat}}"},
      {"type": "stripe", "regions": ["wing_top_l", "wing_top_r", "wing_both"], "axis": "lat", "center": 0.72, "width": 0.05, "color": "{{heat}}"},
      {"type": "fill", "regions": ["wing_leading_edges", "flaps", "ailerons", "hstab_top", "elevators", "gear_doors"], "color": "{{heat|dark:0.3}}"},
      {"type": "decal", "file": "reticle.png", "size": 380, "tint": "#1d2026", "anchor": {"length": 0.86, "height": 0.66}, "region": "fin_l", "baseline": "+length", "up": "+height"},
      {"type": "decal", "file": "reticle.png", "size": 380, "tint": "#1d2026", "anchor": {"length": 0.86, "height": 0.66}, "region": "fin_r", "baseline": "-length", "up": "+height"},
      {"type": "text", "text": "{{label}}", "font": "Bungee-Regular.ttf", "size": 118, "color": "{{heat}}", "anchor": {"length": 0.22, "height": 0.38}, "region": "fuselage_l", "baseline": "+length", "up": "+height"},
      {"type": "text", "text": "{{label}}", "font": "Bungee-Regular.ttf", "size": 118, "color": "{{heat}}", "anchor": {"length": 0.22, "height": 0.38}, "region": "fuselage_r", "baseline": "-length", "up": "+height"}
    ],
    "finish": {"wear": 0.08, "window_color": "#0d0e11"}
  }
}
