{
  "id": "cub_gg_kit",
  "aircraft": "cub",
  "name": "Gun Game kit (Cub)",
  "pilot": false,
  "description": "Gun Game rung paint for the Cub: graphite airframe, heat cowling, belly, wing undersides and tail, heat bands and tips on top of the wing. No title: the fuselage sides are one mirrored island, so text would read backwards on one side.",
  "params": {
    "heat": {
      "type": "color",
      "default": "#5ec8ff",
      "label": "Heat colour"
    },
    "hot": {
      "type": "color",
      "default": "#d9f4ff",
      "label": "Hot highlight"
    }
  },
  "spec": {
    "base": {"*": "#1b1d22", "wing_bottom": "{{heat}}", "fuselage_bottom": "{{heat|dark:0.25}}", "hstab_bottom": "{{heat}}", "struts": "{{heat|dark:0.3}}", "spinner": "{{hot}}"},
    "layers": [
      {"type": "gradient", "regions": ["fuselage_top", "fuselage_l", "fuselage_r", "fuselage_both"], "axis": "height", "stops": [[0.0, "#121317"], [0.5, "#1d2026"], [1.0, "#262a31"]]},
      {"type": "fill", "regions": ["cowling"], "color": "{{heat}}"},
      {"type": "gradient", "regions": ["fuselage_top", "fuselage_l", "fuselage_r", "fuselage_both"], "axis": "length", "range": [0.12, 0.27], "stops": [[0.0, "{{heat}}"], [1.0, "{{heat|alpha:0.0}}"]]},
      {"type": "stripe", "regions": ["fuselage_l", "fuselage_r", "fuselage_both", "cowling"], "axis": "height", "center": 0.45, "width": 0.014, "color": "{{hot}}", "where": {"length": [0.1, 0.95]}},
      {"type": "gradient", "regions": ["fin_l", "fin_r", "fin", "rudder"], "axis": "height", "range": [0.5, 1.0], "stops": [[0.0, "{{heat|dark:0.35}}"], [0.55, "{{heat}}"], [1.0, "{{hot}}"]]},
      {"type": "fill", "regions": ["hstab_top"], "color": "{{heat|dark:0.15}}"},
      {"type": "fill", "regions": ["elevators"], "color": "{{heat}}"},
      {"type": "stripe", "regions": ["wing_top_l", "wing_top_r", "wing_both", "ailerons"], "axis": "lat", "center": 0.3, "width": 0.07, "color": "{{heat}}"},
      {"type": "stripe", "regions": ["wing_top_l", "wing_top_r", "wing_both", "ailerons"], "axis": "lat", "center": 0.7, "width": 0.07, "color": "{{heat}}"},
      {"type": "fill", "regions": ["wing_top_l", "wing_top_r", "wing_both", "ailerons"], "where": {"lat": [0.0, 0.1]}, "color": "{{hot}}"},
      {"type": "fill", "regions": ["wing_top_l", "wing_top_r", "wing_both", "ailerons"], "where": {"lat": [0.9, 1.0]}, "color": "{{hot}}"},
      {"type": "decal", "file": "reticle.png", "size": 70, "tint": "#16181d", "region": "fin", "anchor": {"length": 0.87, "height": 0.8}, "anchor_radius": 70, "baseline": "+length", "up": "+height"}
    ],
    "finish": {"wear": 0.08}
  }
}
