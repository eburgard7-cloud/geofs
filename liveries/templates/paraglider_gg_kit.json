{
  "id": "paraglider_gg_kit",
  "aircraft": "paraglider",
  "name": "Gun Game kit (paraglider)",
  "pilot": false,
  "description": "Gun Game rung paint for the paraglider: heat centre cells, heat rib bands across a graphite span, hot wingtips. No title: the canopy is one mirrored picture, so text would read backwards on one half.",
  "params": {
    "heat": {
      "type": "color",
      "default": "#5ec8ff",
      "label": "Heat colour"
    },
    "hot": {
      "type": "color",
      "default": "#d9f4ff",
      "label": "Hot highlight"
    }
  },
  "spec": {
    "base": {"*": "#1b1d22"},
    "layers": [
      {"type": "fill", "regions": ["canopy_centre"], "color": "{{heat}}"},
      {"type": "stripe", "regions": ["canopy_span"], "axis": "lat", "center": 0.2, "width": 0.035, "period": 0.09, "color": "{{heat}}"},
      {"type": "gradient", "regions": ["canopy_tips"], "axis": "height", "range": [0.0, 0.6], "stops": [[0.0, "{{hot}}"], [0.6, "{{heat}}"], [1.0, "{{heat|dark:0.3}}"]]},
      {"type": "fill", "regions": ["canopy_span", "canopy_centre"], "where": {"length": [0.0, 0.1]}, "color": "{{heat|dark:0.2}}"},
      {"type": "fill", "regions": ["canopy_span", "canopy_centre"], "where": {"length": [0.9, 1.0]}, "color": "{{heat|dark:0.2}}"},
      {"type": "decal", "file": "reticle.png", "size": 70, "tint": "#16181d", "region": "canopy_centre", "at": [0.5, 0.5], "rotate": 0}
    ],
    "finish": {"wear": 0.0}
  }
}
