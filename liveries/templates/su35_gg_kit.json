{
  "id": "su35_gg_kit",
  "aircraft": "su35",
  "name": "Gun Game kit (Su-35)",
  "pilot": false,
  "description": "Gun Game rung paint for the Su-35: graphite jet, heat belly, wing undersides, intakes, radome and fins, heat bands, tips and reticles on top of the wings, reticles on the fins, GUN GAME along the spine.",
  "params": {
    "heat": {
      "type": "color",
      "default": "#5ec8ff",
      "label": "Heat colour"
    },
    "hot": {
      "type": "color",
      "default": "#d9f4ff",
      "label": "Hot highlight"
    },
    "label": {
      "type": "text",
      "default": "GUN GAME",
      "max": 10,
      "label": "Title"
    }
  },
  "spec": {
    "base": {"*": "#1b1d22", "wing_bottom": "{{heat}}", "fuselage_bottom": "{{heat|dark:0.25}}", "ventral_fins": "{{heat}}", "gear_doors": "{{heat|dark:0.25}}", "intake": "{{heat|dark:0.15}}", "hstab_bottom": "{{heat}}"},
    "layers": [
      {"type": "gradient", "regions": ["fuselage_top", "fuselage_l", "fuselage_r", "fuselage_both"], "axis": "height", "stops": [[0.0, "#121317"], [0.55, "#1d2026"], [1.0, "#24272e"]]},
      {"type": "fill", "regions": ["radome"], "color": "{{heat}}"},
      {"type": "gradient", "regions": ["fuselage_top", "fuselage_l", "fuselage_r", "fuselage_both", "canopy_frame"], "axis": "length", "range": [0.05, 0.24], "stops": [[0.0, "{{heat}}"], [0.55, "{{heat|alpha:0.85}}"], [1.0, "{{heat|alpha:0.0}}"]]},
      {"type": "fill", "regions": ["wing_leading_edges", "flaperons"], "color": "{{hot}}"},
      {"type": "stripe", "regions": ["wing_top_l", "wing_top_r", "wing_both"], "axis": "lat", "center": 0.13, "width": 0.045, "color": "{{heat}}"},
      {"type": "stripe", "regions": ["wing_top_l", "wing_top_r", "wing_both"], "axis": "lat", "center": 0.87, "width": 0.045, "color": "{{heat}}"},
      {"type": "fill", "regions": ["wing_top_l", "wing_top_r", "wing_both"], "where": {"lat": [0.0, 0.05]}, "color": "{{hot}}"},
      {"type": "fill", "regions": ["wing_top_l", "wing_top_r", "wing_both"], "where": {"lat": [0.95, 1.0]}, "color": "{{hot}}"},
      {"type": "gradient", "regions": ["fin_l", "fin_r", "fin", "rudder"], "axis": "height", "range": [0.45, 1.0], "stops": [[0.0, "{{heat|dark:0.35}}"], [0.6, "{{heat}}"], [1.0, "{{hot}}"]]},
      {"type": "fill", "regions": ["hstab_top"], "color": "{{heat|dark:0.15}}"},
      {"type": "stripe", "regions": ["hstab_top"], "axis": "length", "center": 0.9, "width": 0.012, "period": 0.04, "color": "{{hot}}"},
      {"type": "stripe", "regions": ["fuselage_l", "fuselage_r", "fuselage_both"], "axis": "height", "center": 0.31, "width": 0.01, "color": "{{heat}}", "where": {"length": [0.12, 0.9]}},
      {"type": "decal", "file": "reticle.png", "size": 640, "tint": "{{heat}}", "region": "wing_top_r", "at": [0.55, 0.5], "baseline": "+lat", "up": "-length"},
      {"type": "decal", "file": "reticle.png", "size": 640, "tint": "{{heat}}", "region": "wing_top_l", "at": [0.45, 0.5], "baseline": "+lat", "up": "-length"},
      {"type": "decal", "file": "reticle.png", "size": 760, "tint": "#16181d", "region": "wing_bottom", "at": [0.5, 0.5], "rotate": 0},
      {"type": "decal", "file": "reticle.png", "size": 380, "tint": "#16181d", "region": "fin_l", "component": 0, "at": [0.45, 0.5], "baseline": "+length", "up": "+height"},
      {"type": "decal", "file": "reticle.png", "size": 380, "tint": "#16181d", "region": "fin_l", "component": 1, "at": [0.45, 0.5], "baseline": "+length", "up": "+height"},
      {"type": "decal", "file": "reticle.png", "size": 380, "tint": "#16181d", "region": "fin_r", "component": 0, "at": [0.45, 0.5], "baseline": "+length", "up": "+height"},
      {"type": "decal", "file": "reticle.png", "size": 380, "tint": "#16181d", "region": "fin_r", "component": 1, "at": [0.45, 0.5], "baseline": "+length", "up": "+height"},
      {"type": "text", "text": "{{label}}", "font": "Bungee-Regular.ttf", "size": 150, "color": "{{heat}}", "stroke": 0.08, "stroke_color": "#000000", "region": "fuselage_top", "anchor": {"length": 0.6, "lat": 0.5, "height": 0.45}, "anchor_radius": 600, "baseline": "+length", "up": "+lat"}
    ],
    "finish": {"wear": 0.08, "soot": 0.3}
  }
}
