{
  "id": "f16_gg_kit",
  "aircraft": "f16",
  "name": "Gun Game kit",
  "description": "Gun Game rung paint: graphite jet, heat-coloured belly, fin, nose and forward chevrons so a pilot's rung reads at a glance from any angle.",
  "pilot": false,
  "params": {
    "heat": {
      "type": "color",
      "default": "#5ec8ff",
      "label": "Heat colour"
    },
    "hot": {
      "type": "color",
      "default": "#d9f4ff",
      "label": "Hot highlight"
    },
    "label": {
      "type": "text",
      "default": "GUN GAME",
      "max": 10,
      "label": "Intake text"
    }
  },
  "spec": {
    "base": {"*": "#1b1d22", "wing_bottom": "{{heat}}", "fuselage_bottom": "{{heat|dark:0.25}}", "ventral_fins": "{{heat}}", "speedbrakes": "{{heat|dark:0.25}}", "gear_doors": "{{heat|dark:0.25}}"},
    "layers": [
      {"type": "gradient", "regions": ["fuselage_top", "fuselage_side_l", "fuselage_side_r", "fuselage_side_both", "intake"], "axis": "height", "stops": [[0.0, "#121317"], [0.55, "#1d2026"], [1.0, "#24272e"]]},
      {"type": "fill", "regions": ["radome"], "color": "{{heat}}"},
      {"type": "gradient", "regions": ["fuselage_top", "fuselage_side_l", "fuselage_side_r", "fuselage_side_both", "intake", "canopy_frame"], "axis": "length", "range": [0.0, 0.2], "stops": [[0.0, "{{heat}}"], [0.55, "{{heat|alpha:0.85}}"], [1.0, "{{heat|alpha:0.0}}"]]},
      {"type": "stripe", "regions": ["fuselage_top", "wing_top_l"], "axis": "lat", "slant": 0.85, "center": 0.62, "width": 0.035, "period": 0.15, "color": "{{heat}}", "where": {"side": "l", "length": [0.3, 0.86]}},
      {"type": "stripe", "regions": ["fuselage_top", "wing_top_r"], "axis": "lat", "slant": -0.85, "center": 0.38, "width": 0.035, "period": 0.15, "color": "{{heat}}", "where": {"side": "r", "length": [0.3, 0.86]}},
      {"type": "fill", "regions": ["wing_leading_edges", "wingtip_rails", "flaperons"], "color": "{{hot}}"},
      {"type": "gradient", "regions": ["fin", "rudder"], "axis": "height", "range": [0.45, 1.0], "stops": [[0.0, "{{heat|dark:0.35}}"], [0.6, "{{heat}}"], [1.0, "{{hot}}"]]},
      {"type": "fill", "regions": ["hstab_top_r", "hstab_shared"], "color": "{{heat|dark:0.15}}"},
      {"type": "stripe", "regions": ["hstab_top_r", "hstab_shared"], "axis": "length", "center": 0.9, "width": 0.012, "period": 0.04, "color": "{{hot}}"},
      {"type": "stripe", "regions": ["fuselage_*", "intake"], "axis": "height", "center": 0.33, "width": 0.012, "color": "{{heat}}", "where": {"length": [0.2, 0.92]}},
      {"type": "decal", "file": "reticle.png", "size": 330, "tint": "{{heat}}", "region": "wing_top_r", "at": [0.6, 0.5], "baseline": "+lat", "up": "-length"},
      {"type": "decal", "file": "reticle.png", "size": 330, "tint": "{{heat}}", "region": "wing_top_l", "at": [0.4, 0.5], "baseline": "+lat", "up": "-length"},
      {"type": "decal", "file": "reticle.png", "size": 420, "tint": "#16181d", "region": "wing_bottom", "at": [0.5, 0.5], "rotate": 0},
      {"type": "decal", "file": "reticle.png", "size": 300, "tint": "#16181d", "region": "fin", "anchor": {"length": 0.87, "height": 0.7}, "anchor_radius": 220, "baseline": "+length", "up": "+height"},
      {"type": "text", "text": "{{label}}", "font": "Bungee-Regular.ttf", "size": 64, "color": "{{heat}}", "stroke": 0.08, "stroke_color": "#000000", "region": ["intake", "fuselage_*"], "anchor": {"length": 0.41, "height": 0.34, "lat": 0.43, "facing": "side"}, "baseline": "+length", "up": "+height"},
      {"type": "text", "text": "{{label}}", "font": "Bungee-Regular.ttf", "size": 64, "color": "{{heat}}", "stroke": 0.08, "stroke_color": "#000000", "region": ["intake", "fuselage_*"], "anchor": {"length": 0.41, "height": 0.34, "lat": 0.57, "facing": "side"}, "baseline": "-length", "up": "+height"}
    ],
    "finish": {"panel_lines": 0.4, "wear": 0.08, "soot": 0.3}
  }
}
